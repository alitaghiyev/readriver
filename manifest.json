{
  "manifest_version": 3,
  "name": "ReadRiver",
  "version": "0.10.5",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "contextMenus", "tabs", "scripting", "activeTab", "webNavigation"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://translate.googleapis.com/*",
    "https://translation.googleapis.com/*",
    "https://api.mymemory.translated.net/*",
    "https://tatoeba.org/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*",
    "https://integrate.api.nvidia.com/*",
    "https://api.cognitive.microsofttranslator.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://api.cerebras.ai/*",
    "https://api.mistral.ai/*",
    "https://models.github.ai/*",
    "https://api.sambanova.ai/*",
    "https://router.huggingface.co/*",
    "https://api.cloudflare.com/*",
    "https://api.deepseek.com/*",
    "https://api.together.xyz/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ReadRiver",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+R" }, "description": "__MSG_cmdOpen__" },
    "toggle-tag-mode": { "suggested_key": { "default": "Alt+T" }, "description": "__MSG_cmdTagMode__" }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/prefs.js", "shared/langs.js", "shared/i18n.js", "shared/render.js", "shared/tagfit.js", "content/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["shared/result.css"], "matches": ["<all_urls>"] }
  ]
}
